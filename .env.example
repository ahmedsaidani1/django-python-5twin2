# Copy to .env and adjust. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL (docker compose up db). Without it, a local SQLite file is used.
DATABASE_URL=postgres://cargolink:cargolink@localhost:5432/cargolink
# DATABASE_URL=sqlite:///db.sqlite3

# Redis / Celery (docker compose up redis). If Redis is unreachable, AI jobs run in a background thread.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# AI provider: local (default, no network) | openai (any OpenAI-compatible API) | anthropic
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15
AI_MAX_RETRIES=2

# E-mail (console backend prints password-reset links in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CargoLink <no-reply@cargolink.tn>

# Production only (config.settings.prod)
SECURE_SSL_REDIRECT=True
SECURE_COOKIES=True
SECURE_HSTS_SECONDS=31536000
